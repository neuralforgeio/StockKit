# StockKit development environment. Copy to .env and change all passwords.

# API
STOCKKIT_ENV=development
API_PORT=8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockkit
POSTGRES_USER=change-your-user
POSTGRES_PASSWORD=change-your-password
POSTGRES_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=stockkit
MINIO_ROOT_PASSWORD=change-me-minio

# Frontend -> backend (server-side fetch)
BACKEND_URL=http://localhost:8080

# AES-256-GCM key for encrypted master-data fields (base64, 32 bytes)
FIELD_ENCRYPTION_KEY=

# JWT Configuration EDDSA Key
JWT_EDDSA_KEY=
