# StockKit development environment. Copy to .env and change all passwords.

# API
STOCKKIT_ENV=development
API_PORT=8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockkit
POSTGRES_USER=userpostgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_SSLMODE=disable
APP_DB_PASSWORD=change-me-app

# Redis
REDIS_ADDR=localhost:6379
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=stockkit
MINIO_ROOT_PASSWORD=change-me-minio

# Frontend -> backend (server-side fetch)
BACKEND_URL=http://localhost:8080
